  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Host Core Utilization",
      "type": "row"
    },
    {
      "id": 1,
      "title": "CPU Total Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(windows_cpu_time_total{mode='idle'}[1m])) * 100)",
          "legendFormat": "CPU Busy %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Physical Memory Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "100 - (windows_os_physical_memory_free_bytes / windows_cs_physical_memory_bytes * 100)",
          "legendFormat": "RAM Used %",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Storage & Network",
      "type": "row"
    },
    {
      "id": 3,
      "title": "Disk C: Space Used (%)",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 - (windows_logical_disk_free_bytes{volume=~'C:.*'} / windows_logical_disk_size_bytes{volume=~'C:.*'} * 100)",
          "legendFormat": "C: Used %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Network Traffic Throughput (Bytes/sec)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(windows_net_bytes_received_total[1m]))",
          "legendFormat": "Traffic In",
          "refId": "A"
        },
        {
          "expr": "sum(rate(windows_net_bytes_sent_total[1m]))",
          "legendFormat": "Traffic Out",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Network Round-Trip Latency (ms) [Blackbox Probe]",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job='blackbox-network'} * 1000",
          "legendFormat": "RTT Latency (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Probe Availability / Reachability (%)",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "probe_success{job='blackbox-network'} * 100",
          "legendFormat": "Reachability %",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
